# Server Configuration
PORT=4000
NODE_ENV=development
ENABLE_LOGGING=true

# Generic API proxy
# Any /api request the BFF has no route for is forwarded to this base URL
# (src/server/services/http-client.service.ts). Leave as-is until you have a backend.
API_BASE_URL=https://your-backend-api.com
API_TIMEOUT=30000

# Sign-in (demo account)
# The template has one demo account and no external auth provider - see
# docs/AUTHENTICATION.md to plug in a real one.
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=demo1234
# Signs the session cookie. Required in production - use a long random string.
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TTL_HOURS=12

# File uploads (Mini-Library "Add assets")
# Filestack API key (public - the browser uploads with it).
FILESTACK_API_KEY=

# Mini-Library database (Supabase). Create the table with
# supabase/migrations/20261109000000_create_library_assets.sql.
# The service role key is a server-side secret: never expose it to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Production Origin Validation (for production environments)
ALLOWED_ORIGIN=https://yourdomain.com
