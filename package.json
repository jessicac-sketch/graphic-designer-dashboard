{
    "name": "internal-tool-boilerplate",
    "version": "0.1.0",
    "scripts": {
        "ng": "ng",
        "start": "concurrently -n ui,bff -c blue,magenta \"npm:start:ui\" \"npm:start:bff\"",
        "start:ui": "ng serve",
        "start:bff": "cross-env NODE_ENV=development tsx watch src/server/main.ts",
        "build": "npm run build:ui && npm run build:bff",
        "build:dev": "cross-env NODE_ENV=development npm run build",
        "build:ui": "ng build",
        "build:bff": "tsc -p tsconfig.server.json && node scripts/build-server.mjs",
        "watch": "ng build --watch --configuration development",
        "test": "ng test",
        "serve": "cross-env NODE_ENV=production node dist/internal-tool-boilerplate/server/server.mjs",
        "serve:dev": "cross-env NODE_ENV=development node dist/internal-tool-boilerplate/server/server.mjs",
        "pretty": "prettier --write \"./**/*.{html,js,jsx,mjs,cjs,ts,tsx,json,scss,css}\"",
        "pretty:quick": "pretty-quick",
        "pretty:staged": "pretty-quick --staged",
        "pretty:check": "pretty-quick --check"
    },
    "private": true,
    "overrides": {
        "exceljs": {
            "uuid": "^11.1.1"
        }
    },
    "dependencies": {
        "@angular/animations": "^21.2.0",
        "@angular/cdk": "^21.2.0",
        "@angular/common": "^21.2.0",
        "@angular/compiler": "^21.2.0",
        "@angular/core": "^21.2.0",
        "@angular/forms": "^21.2.0",
        "@angular/platform-browser": "^21.2.0",
        "@angular/platform-browser-dynamic": "^21.2.0",
        "@angular/router": "^21.2.0",
        "@ntv360/component-pantry": "^0.7.8",
        "@supabase/supabase-js": "^2.119.0",
        "apexcharts": "^5.16.0",
        "axios": "^1.12.2",
        "cookie": "^2.0.1",
        "dotenv": "^17.2.3",
        "echarts": "^6.1.0",
        "exceljs": "^4.4.0",
        "express": "^5.1.0",
        "filestack-js": "^4.3.9",
        "lottie-web": "^5.13.0",
        "ng-apexcharts": "^2.5.0",
        "rxjs": "~7.8.0",
        "tslib": "^2.3.0",
        "uuid": "^14.0.0",
        "zone.js": "~0.15.1"
    },
    "devDependencies": {
        "@angular/build": "^21.2.0",
        "@angular/cli": "^21.2.0",
        "@angular/compiler-cli": "^21.2.0",
        "@commitlint/cli": "^20.1.0",
        "@commitlint/config-conventional": "^20.0.0",
        "@types/express": "^5.0.4",
        "@types/jasmine": "~5.1.0",
        "@types/node": "^20.19.23",
        "autoprefixer": "^10.4.22",
        "concurrently": "^10.0.6",
        "cross-env": "^10.1.0",
        "esbuild": "^0.28.2",
        "husky": "^9.0.11",
        "jasmine-core": "~5.1.0",
        "karma": "~6.4.0",
        "karma-chrome-launcher": "~3.2.0",
        "karma-coverage": "~2.2.0",
        "karma-jasmine": "~5.1.0",
        "karma-jasmine-html-reporter": "~2.1.0",
        "postcss": "^8.5.6",
        "prettier": "^3.3.2",
        "prettier-plugin-organize-imports": "^4.3.0",
        "pretty-quick": "^4.2.2",
        "tailwindcss": "^3.4.18",
        "tsx": "^4.23.15",
        "typescript": "~5.9.3"
    },
    "allowScripts": {
        "esbuild@0.28.1": true,
        "esbuild@0.28.2": true,
        "@parcel/watcher@2.6.0": true,
        "lmdb@3.5.1": true,
        "msgpackr-extract@3.0.4": true
    }
}
